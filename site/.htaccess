# Bfiluxe — Hostinger (LiteSpeed/Apache) settings
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
# Always use https; www goes to the bare domain (bfiluxe.com)
RewriteCond %{HTTP_HOST} ^www\.bfiluxe\.com$ [NC]
RewriteRule ^(.*)$ https://bfiluxe.com/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Clean addresses: bfiluxe.com/pricing instead of /pricing.html
# 1) old links: /index.html -> /, /pricing.html -> /pricing (keeps ?query)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]
# 2) /pricing/ -> /pricing (folders such as /live-demo-1/ are left alone)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/$ /$1 [R=301,L]
# 3) serve /pricing from pricing.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z0-9-]+)$ $1.html [L]

# Hide repository files
RedirectMatch 404 /\.git
RedirectMatch 404 /README\.md$

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  <FilesMatch "\.(css|js|webp|jpg|jpeg|png|svg|woff2|mp3|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <Files "bfi-contact.vcf">
    Header set Content-Disposition "attachment; filename=\"Bfiluxe.vcf\""
  </Files>
</IfModule>

AddType text/vcard .vcf
AddType application/manifest+json .webmanifest
AddType image/webp .webp

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/plain
</IfModule>
